# Settings for the private install, read by both units in this directory.
# Copy to ~/.local/share/text-adventure-web/deploy.env.
# Secrets (OPENROUTER_API_KEY or TYPESAFE_API_KEY, SECRET_KEY_BASE) go in
# secrets.env beside it, mode 600, never here and never in the repo.
RAILS_ENV=production
BUNDLE_DEPLOYMENT=1
BUNDLE_WITHOUT=development:test

# The databases, outside the checkout so a re-clone keeps the worlds.
DATABASE_URL=sqlite3:///home/you/.local/share/text-adventure-web/data/production.sqlite3
CACHE_DATABASE_URL=sqlite3:///home/you/.local/share/text-adventure-web/data/production_cache.sqlite3
QUEUE_DATABASE_URL=sqlite3:///home/you/.local/share/text-adventure-web/data/production_queue.sqlite3
CABLE_DATABASE_URL=sqlite3:///home/you/.local/share/text-adventure-web/data/production_cable.sqlite3

# Turns are jobs; run the queue inside Puma so one unit is the whole app.
SOLID_QUEUE_IN_PUMA=1

# tailscale serve terminates TLS and forwards plain http to 127.0.0.1.
RAILS_FORCE_SSL=true
RAILS_ASSUME_SSL=true
RAILS_LOG_LEVEL=info

# The tailnet name the app answers to (config/allowed_hosts.rb); comma-separated.
RAILS_ALLOWED_HOSTS=mymachine.example-tailnet.ts.net

# The port bin/start binds, on 127.0.0.1 only.
PORT=3200

# The local line reader (text-adventure-web-reader.service).
POINTER_CLASSIFIER_URL=http://127.0.0.1:3201
POINTER_CLASSIFIER_WEIGHTS=/home/you/.local/share/text-adventure-web/pointer/weights
POINTER_CLASSIFIER_PYTHON=/home/you/.local/share/text-adventure-web/pointer/venv/bin/python
POINTER_CLASSIFIER_THREADS=2

# Show the debug view on this install (app/models/playthrough/debug.rb).
TA_DEBUG_VIEW=false
